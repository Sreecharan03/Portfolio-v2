# Canonical URL used for metadata, Open Graph, sitemap and JSON-LD.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Portfolio assistant (optional). Server-only: never prefix with NEXT_PUBLIC_.
# Without a key the chat button is not shown. Set it in Vercel → Settings → Environment Variables.
GROQ_API_KEY=
# Optional: models to try in order (comma-separated). Default:
# GROQ_MODEL=moonshotai/kimi-k2-instruct-0905,openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3-32b
# GROQ_ANALYZER_MODEL=llama-3.1-8b-instant
